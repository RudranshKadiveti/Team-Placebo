generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SystemCheck {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile          Profile?
  resumes          Resume[]
  githubConnection GitHubConnection?
  githubRepos      GitHubRepository[]

  @@map("users")
}

model Resume {
  id                String        @id @default(uuid())
  userId            String
  originalFileName  String
  fileType          String
  fileSize          Int
  storageKey        String
  rawText           String?
  structuredContent String?
  atsScore          String?
  uploadedAt        DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks ResumeChunk[]

  @@map("resumes")
}

model ResumeChunk {
  id                 String   @id @default(uuid())
  resumeId           String
  chunkIndex         Int
  sectionType        String
  content            String
  contentHash        String
  embedding          String?
  embeddingModel     String
  embeddingVersion   String
  embeddingDimension Int
  normalized         Boolean  @default(true)
  chunkingVersion    String
  createdAt          DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_chunks")
}

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  phone           String?
  location        String?
  university      String?
  degree          String?
  fieldOfStudy    String?
  graduationYear  Int?
  experienceLevel String?
  bio             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerGoals CareerGoal[]

  @@map("profiles")
}

model CareerGoal {
  id             String   @id @default(uuid())
  profileId      String
  targetRole     String
  targetIndustry String?
  targetLocation String?
  priority       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("career_goals")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  email     String   @unique
  tokenHash String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model GitHubConnection {
  id                   String    @id @default(uuid())
  userId               String    @unique
  githubUserId         String?
  username             String
  accessTokenEncrypted String?
  scopes               String?
  connectedAt          DateTime  @default(now())
  lastSyncedAt         DateTime?
  lastAnalyzedAt       DateTime?
  tokenUpdatedAt       DateTime?

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  repos GitHubRepository[]

  @@map("github_connections")
}

model GitHubRepository {
  id                 String   @id @default(uuid())
  userId             String
  connectionId       String
  githubRepoId       Int
  name               String
  fullName           String
  description        String?
  htmlUrl            String
  cloneUrl           String?
  defaultBranch      String   @default("main")
  isPrivate          Boolean  @default(false)
  isFork             Boolean  @default(false)
  isArchived         Boolean  @default(false)
  isTemplate         Boolean  @default(false)
  createdAt          DateTime
  updatedAt          DateTime
  pushedAt           DateTime
  size               Int      @default(0)
  stargazersCount    Int      @default(0)
  watchersCount      Int      @default(0)
  forksCount         Int      @default(0)
  openIssuesCount    Int      @default(0)
  primaryLanguage    String?
  topicsJson         String?
  languagesJson      String?
  dependenciesJson   String?
  relevanceScore     Int      @default(50)
  classification     String   @default("Other")
  complexityScore    Int      @default(50)
  healthScore        Int      @default(50)
  documentationScore Int      @default(50)
  testingScore       Int      @default(50)
  cicdScore          Int      @default(50)
  analysisJson       String?
  lastSyncedAt       DateTime @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection GitHubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, githubRepoId])
  @@map("github_repositories")
}
